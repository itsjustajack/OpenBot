{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__github__create_pull_request|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/fork-only-prs.ts\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-edited-file.ts\""
          }
        ]
      }
    ]
  }
}
